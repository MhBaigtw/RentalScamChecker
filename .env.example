# Copy to .env at the repo root and adjust. Every variable the project reads is listed here.
# Real environment variables override values in .env.

# --- Postgres (docker-compose.yml) ---
POSTGRES_USER=rsc
POSTGRES_PASSWORD=rsc_dev_password
POSTGRES_DB=rentalscamchecker
# Host port. 5432/5433 are taken by other projects on the dev machine.
POSTGRES_PORT=5434

# --- API (apps/api) ---
# SQLAlchemy URL, psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://rsc:rsc_dev_password@localhost:5434/rentalscamchecker
# Seconds to wait when opening a DB connection (keeps /health fast when the DB is down).
DATABASE_CONNECT_TIMEOUT=2
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# The API listens on 8100 (uvicorn --port 8100); 8000 is taken on the dev machine.
API_PORT=8100

# --- Web (apps/web) ---
# Base URL the Next.js server uses to reach the API. The web app runs on port 3100.
API_URL=http://localhost:8100
# Secret key for HMAC-SHA256 of contact phone numbers and emails (min 32 chars). This value is
# for local development only; generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it breaks matching against contact hashes stored before the change.
CONTACT_HASH_PEPPER=dev-only-pepper-change-me-0123456789abcdef
# Region for phone numbers typed without a country code.
CONTACT_DEFAULT_REGION=CA
# Local-disk photo storage. Relative paths resolve from the repo root (gitignored).
PHOTO_STORAGE_DIR=var/photos

# --- Tests (apps/api) ---
# Integration tests use a separate database, created and migrated automatically and emptied after
# each test. Default: DATABASE_URL's database name + "_test". The name must end in "_test".
# TEST_DATABASE_URL=postgresql+psycopg://rsc:rsc_dev_password@localhost:5434/rentalscamchecker_test
