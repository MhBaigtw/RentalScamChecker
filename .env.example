# Copy to .env at the repo root and adjust. Every variable the project reads is listed here.
# Real environment variables override values in .env.

# --- Postgres (docker-compose.yml) ---
POSTGRES_USER=rsc
POSTGRES_PASSWORD=rsc_dev_password
POSTGRES_DB=rentalscamchecker
# Host port. 5432/5433 are taken by other projects on the dev machine.
POSTGRES_PORT=5434

# --- API (apps/api) ---
# SQLAlchemy URL, psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://rsc:rsc_dev_password@localhost:5434/rentalscamchecker
# Seconds to wait when opening a DB connection (keeps /health fast when the DB is down).
DATABASE_CONNECT_TIMEOUT=2
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# The API listens on 8100 (uvicorn --port 8100); 8000 is taken on the dev machine.
API_PORT=8100

# --- Web (apps/web) ---
# Base URL the Next.js server uses to reach the API. The web app runs on port 3100.
# 127.0.0.1, not localhost: on Windows localhost tries IPv6 (::1) first and each new connection
# waited ~2 s before falling back, because the API listens on 127.0.0.1 only (problems-and-solutions P-006).
API_URL=http://127.0.0.1:8100
# Secret key for HMAC-SHA256 of contact phone numbers and emails (min 32 chars). This value is
# for local development only; generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it breaks matching against contact hashes stored before the change.
CONTACT_HASH_PEPPER=dev-only-pepper-change-me-0123456789abcdef
# Region for phone numbers typed without a country code.
CONTACT_DEFAULT_REGION=CA
# Local-disk photo storage. Relative paths resolve from the repo root (gitignored).
PHOTO_STORAGE_DIR=var/photos

# --- Tests (apps/api) ---
# Integration tests use a separate database, created and migrated automatically and emptied after
# each test. Default: DATABASE_URL's database name + "_test". The name must end in "_test".
# TEST_DATABASE_URL=postgresql+psycopg://rsc:rsc_dev_password@localhost:5434/rentalscamchecker_test

# --- Signals and job queue (API + worker, M2) ---
# Comma-separated signals run for each new check: price_vs_market, address_sanity (M3),
# text_red_flags (M4). "stub" (sleeps, checks nothing) exists only to test the pipeline; the test
# suite pins it. address_sanity needs NOMINATIM_CONTACT_EMAIL and text_red_flags needs
# ANTHROPIC_API_KEY (below); the API and worker refuse to start without them.
ENABLED_SIGNALS=price_vs_market,address_sanity,text_red_flags
STUB_SIGNAL_SLEEP_SECONDS=1.0
# The aggregator finalizes a check when every signal has a result, or after this many seconds.
CHECK_TIMEOUT_SECONDS=120
JOB_MAX_ATTEMPTS=5
# A claimed job is reserved this long; after that (crash/hang) it is handed out again.
JOB_LEASE_SECONDS=60
# Hard limit for one attempt of one job; must be below JOB_LEASE_SECONDS (checked at startup).
# An attempt that overruns is failed and retried with backoff (ED-017).
JOB_TIMEOUT_SECONDS=45
# Retry n waits min(JOB_BACKOFF_MAX_SECONDS, JOB_BACKOFF_BASE_SECONDS * 2^(n-1)).
JOB_BACKOFF_BASE_SECONDS=2.0
JOB_BACKOFF_MAX_SECONDS=300
# Worker threads per worker process, and how often an idle thread polls the queue.
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_SECONDS=1.0
# How often each worker writes its counters to worker_heartbeats (shown by /internal/metrics).
WORKER_HEARTBEAT_INTERVAL_SECONDS=5

# --- price_vs_market (M3) ---
# Severity medium/high when the rent is at least this many percent below the CMHC reference.
# Never shown to users. Reference data: python -m rentalscamchecker.reference_rents <csv>
PRICE_MEDIUM_BELOW_PERCENT=30
PRICE_HIGH_BELOW_PERCENT=50

# --- address_sanity / Nominatim geocoding (M3) ---
# REQUIRED if address_sanity is enabled: a contact email for Nominatim's operators, sent in our
# User-Agent as their usage policy asks. Use an address you read. Not committed anywhere else.
NOMINATIM_CONTACT_EMAIL=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim allows at most 1 request per second in total; values below 1.0 are rejected.
NOMINATIM_MIN_INTERVAL_SECONDS=1.0
# HTTP timeouts (connect; each read) and the longest wait for our turn at the rate limit.
# lock wait + interval + connect + read must stay below JOB_TIMEOUT_SECONDS (checked at startup).
GEOCODER_CONNECT_TIMEOUT_SECONDS=5
GEOCODER_TIMEOUT_SECONDS=10
GEOCODER_LOCK_WAIT_SECONDS=15

# --- Internal endpoints ---
# Bearer token for GET /internal/metrics. Unset: open in development/test, disabled in production.
# INTERNAL_METRICS_TOKEN=

# --- text_red_flags: Anthropic API (M4) ---
# REQUIRED if text_red_flags is enabled. Calls cost money; keep the daily cap low.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (thinking depth and token spend).
ANTHROPIC_EFFORT=medium
# One attempt per call (SDK retries off); cap lock wait + timeout x (retries + 1) must stay below
# JOB_TIMEOUT_SECONDS (checked at startup).
ANTHROPIC_TIMEOUT_SECONDS=25
ANTHROPIC_MAX_RETRIES=0
ANTHROPIC_MAX_TOKENS=8000
# Cost guards: API calls per UTC day across all workers (cache hits are free), and listings longer
# than this many characters use the keyword fallback instead of the API.
LLM_DAILY_CALL_CAP=200
LLM_MAX_INPUT_CHARS=8000
LLM_CAP_LOCK_WAIT_SECONDS=5
